# dashboard.py / sector_heatmap.py 本機測試時使用
# 複製這個檔案的內容，建立成 .streamlit/secrets.toml（該資料夾/檔案已被 .gitignore 排除，不會上傳）
# 部署到 Streamlit Cloud 時，改在網站的 App settings → Secrets 貼上同樣格式的內容，不需要這個檔案

db_user = "postgres"
db_password = "你的Supabase資料庫密碼"
db_host = "aws-0-ap-northeast-1.pooler.supabase.com"
db_port = "5432"
db_name = "postgres"
