# 本機跑 Streamlit 頁面（streamlit run Swing_Trading_Decision_System.py）時使用。
# 複製這個檔案的內容，建立成 .streamlit/secrets.toml（該檔案已被 .gitignore 排除，不會上傳）。
# 部署到 Streamlit Cloud 時不需要這個檔案：到 App settings → Secrets 貼上同樣格式的內容。
#
# ⚠️ 這個範本只放佔位文字，請不要把真實的密碼寫進這個檔案後 commit。

# Supabase 連線池（Session pooler）的使用者名稱必須是「postgres.<專案ID>」，
# 只寫 "postgres" 會連線失敗（錯誤訊息：no tenant identifier provided）。
# 專案ID 在 Supabase 後台 Project Settings → General 的 Project ID。
db_user = "postgres.你的專案ID"
db_password = "你的Supabase資料庫密碼"
db_host = "aws-0-ap-northeast-1.pooler.supabase.com"
db_port = "5432"
db_name = "postgres"
